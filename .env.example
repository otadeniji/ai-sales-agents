# Copy to .env and fill in. Never commit the real .env.

# --- LiveKit ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Telnyx ---
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=+1XXXXXXXXXX
# Filled in after `lk sip inbound create`:
LIVEKIT_INBOUND_TRUNK_ID=

# --- Simli (web-avatar lane; avatar skipped if these are empty) ---
SIMLI_API_KEY=
SIMLI_FACE_ID=
SIMLI_EMOTION_ID=

# Rooms starting with this prefix are treated as phone calls (no avatar).
# Must match the roomPrefix in sip/dispatch-rule.json.
SIP_ROOM_PREFIX=call-

# --- Voice pipeline providers ---
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
# Pick one TTS provider:
CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
